{
  "name": "IXPANSION Local Organism",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "python3 -m venv .venv && .venv/bin/pip install -U pip && (.venv/bin/pip install -r requirements.txt || true) && chmod +x scripts/ix_shell.sh 2>/dev/null || true",
  "postStartCommand": "echo 'IX ready — make shell | make council | make dashboard'",
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "GitHub.vscode-pull-request-github"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "terminal.integrated.env.linux": {
          "PYTHONPATH": "${workspaceFolder}",
          "IXPANSION_ROOT": "${workspaceFolder}"
        },
        "editor.formatOnSave": true
      }
    }
  },
  "forwardPorts": [8765, 3000],
  "portsAttributes": {
    "8765": { "label": "Local Control Dashboard", "onAutoForward": "openBrowser" },
    "3000": { "label": "Organism API", "onAutoForward": "notify" }
  },
  "remoteUser": "vscode"
}
