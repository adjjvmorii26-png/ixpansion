{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ixpansion://context/artifact.schema.json",
  "title": "IXPANSION compact context artifact",
  "description": "One fact per record. Load via pack(budget), never paste chat history.",
  "type": "object",
  "required": ["kind", "id", "t"],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["pulse", "receipt", "seed", "residue", "contract", "pointer"]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Stable id; duplicates with different body fail closed on bind."
    },
    "t": {
      "type": "string",
      "description": "ISO-8601 date or datetime (UTC preferred)."
    },
    "sha": {
      "type": "string",
      "description": "Optional content or commit hash."
    },
    "body": {
      "type": "object",
      "description": "Kind-specific payload; keep flat and short.",
      "additionalProperties": true
    },
    "ttl_days": {
      "type": "integer",
      "minimum": 0,
      "description": "0 = permanent. Pulses default short TTL."
    },
    "refs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Ids of related artifacts."
    }
  }
}
