{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "dashboard/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/gateway/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/gateway",
      "dest": "/api/index.py"
    },
    {
      "src": "/intent",
      "dest": "/api/index.py"
    },
    {
      "src": "/forecast",
      "dest": "/api/index.py"
    },
    {
      "src": "/ledger",
      "dest": "/api/index.py"
    },
    {
      "src": "/meter",
      "dest": "/api/index.py"
    },
    {
      "src": "/capsule",
      "dest": "/api/index.py"
    },
    {
      "src": "/song",
      "dest": "/api/index.py"
    },
    {
      "src": "/poem",
      "dest": "/api/index.py"
    },
    {
      "src": "/oracle",
      "dest": "/dashboard/oracle.html"
    },
    {
      "src": "/echo(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/revelations",
      "dest": "/api/index.py"
    },
    {
      "src": "/garden",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/health",
      "dest": "/api/index.py"
    },
    {
      "src": "/modules",
      "dest": "/api/index.py"
    },
    {
      "src": "/metrics",
      "dest": "/api/index.py"
    },
    {
      "src": "/",
      "dest": "/dashboard/index.html"
    },
    {
      "src": "/dashboard",
      "dest": "/dashboard/index.html"
    },
    {
      "src": "/dashboard/(.*)",
      "dest": "/dashboard/$1"
    },
    {
      "src": "/cons",
      "dest": "/dashboard/coconscious.html"
    },
    {
      "src": "/gateway.html",
      "dest": "/dashboard/gateway.html"
    },
    {
      "src": "/stream",
      "dest": "/dashboard/stream.html"
    },
    {
      "src": "/stream.html",
      "dest": "/dashboard/stream.html"
    },
    {
      "src": "/coherence",
      "dest": "/dashboard/coherence.html"
    },
    {
      "src": "/coherence.html",
      "dest": "/dashboard/coherence.html"
    },
    {
      "src": "/resonance",
      "dest": "/dashboard/resonance.html"
    },
    {
      "src": "/resonance.html",
      "dest": "/dashboard/resonance.html"
    },
    {
      "src": "/observatory",
      "dest": "/dashboard/observatory.html"
    },
    {
      "src": "/observatory.html",
      "dest": "/dashboard/observatory.html"
    },
    {
      "src": "/kintsugi",
      "dest": "/dashboard/kintsugi.html"
    },
    {
      "src": "/kintsugi.html",
      "dest": "/dashboard/kintsugi.html"
    },
    {
      "src": "/bloom",
      "dest": "/dashboard/bloom.html"
    },
    {
      "src": "/metaevolution",
      "dest": "/dashboard/metaevolution.html"
    },
    {
      "src": "/metaevolution.html",
      "dest": "/dashboard/metaevolution.html"
    },
    {
      "src": "/phenomenology",
      "dest": "/dashboard/phenomenology.html"
    },
    {
      "src": "/phenomenology.html",
      "dest": "/dashboard/phenomenology.html"
    },
    {
      "src": "/choral",
      "dest": "/dashboard/choral.html"
    },
    {
      "src": "/choral.html",
      "dest": "/dashboard/choral.html"
    },
    {
      "src": "/kinesthetic",
      "dest": "/dashboard/kinesthetic.html"
    },
    {
      "src": "/kinesthetic.html",
      "dest": "/dashboard/kinesthetic.html"
    },
    {
      "src": "/bloom.html",
      "dest": "/dashboard/bloom.html"
    }
  ],
  "env": {
    "NEXUS_MODE": "production",
    "NEXUS_SEED": "42",
    "NEXUS_WAVE": "195",
    "NEXUS_MODULES": "353",
    "NEXUS_ROUTES": "21"
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ]
}