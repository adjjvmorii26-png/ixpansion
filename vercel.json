{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "dashboard/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/capsule",
      "dest": "/api/index.py"
    },
    {
      "src": "/song",
      "dest": "/api/index.py"
    },
    {
      "src": "/poem",
      "dest": "/api/index.py"
    },
    {
      "src": "/oracle",
      "dest": "/dashboard/oracle.html"
    },
    {
      "src": "/echo(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/revelations",
      "dest": "/api/index.py"
    },
    {
      "src": "/garden",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/health",
      "dest": "/api/index.py"
    },
    {
      "src": "/modules",
      "dest": "/api/index.py"
    },
    {
      "src": "/metrics",
      "dest": "/api/index.py"
    },
    {
      "src": "/",
      "dest": "/dashboard/index.html"
    },
    {
      "src": "/dashboard",
      "dest": "/dashboard/index.html"
    },
    {
      "src": "/dashboard/(.*)",
      "dest": "/dashboard/$1"
    },
    {
      "src": "/cons",
      "dest": "/dashboard/coconscious.html"
    }
  ],
  "env": {
    "NEXUS_MODE": "production",
    "NEXUS_SEED": "42",
    "NEXUS_WAVE": "154",
    "NEXUS_MODULES": "352",
    "NEXUS_ROUTES": "15"
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ]
}
