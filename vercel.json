{
  "version": 2,
  "routes": [
    { "src": "^/api/(.*)", "dest": "/api/index.py" },
    { "src": "^/health$", "dest": "/api/index.py" },
    { "src": "^/modules$", "dest": "/api/index.py" },
    { "src": "^/metrics$", "dest": "/api/index.py" },
    { "src": "^/events$", "dest": "/api/index.py" },
    { "src": "^/telegram-webhook$", "dest": "/api/index.py" },
    { "src": "^/dashboard/(.*)", "dest": "/dashboard/$1" },
    { "src": "^/$", "dest": "/dashboard/index.html" }
  ]
}
