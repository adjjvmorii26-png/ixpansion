{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "dashboard/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/gateway/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/gateway",
      "dest": "/api/index.py"
    },
    {
      "src": "/intent",
      "dest": "/api/index.py"
    },
    {
