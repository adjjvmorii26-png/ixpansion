# IXpansion Environment Configuration — template (copy to .env and fill real values)
# Never commit a real .env. The example uses <your_...> placeholders only.

# --- Wave / runtime ---
NEXUS_WAVE=720
ALEPH_SECRET_NAME=lxl.aleph

# --- Git / deployments ---
IXP_GH_TOKEN=<your_github_pat>
VERCEL_DEPLOY_TOKEN=<your_vercel_deploy_token>
VERCEL_PROJECT_TOKEN=<your_vercel_project_token>
VERCEL_CHECKS_TOKEN=<your_vercel_checks_token>

# --- Messaging / bots ---
TELEGRAM_BOT_TOKEN=<your_telegram_bot_token>
VIBE_BOT_TOKEN=<your_vibe_bot_token>
VIBE=https://vibebuild.pro/proxy/openrouter-free

# --- Cloudflare ---
CLOUF_API_KEY=<your_cloudflare_api_key>
C_F_ID=<your_cloudflare_account_id>

# --- AI / LLM providers ---
OPENROUTER_API_KEY=<your_openrouter_key>
GROQ_API_KEY=<your_groq_key>
OPENAI_API_KEY=<your_openai_key>
CLAUDE_API_KEY=<your_anthropic_key>
GOOGLE_API_KEY=<your_google_key>
GOOGLE_API_KEY_2=<your_google_key_2>
BAZAARLINK_BASE_URL=https://api.bazaarlink.ai/v1
BAZAARLINK_API_KEY=<your_bazaarlink_key>

# --- Tools / infra ---
AWS_MCP_PROXY_PROFILES=<your_aws_profile_id>
S_KEY=<your_s_key>
RUNWAYML_API_SECRET=<your_runwayml_key>

# --- Pending / CI-only ---
# AI_GATEWAY_API_KEY=<needs real key>
# CF_API_TOKEN / CF_ACCOUNT_ID / CF_TUNNEL_TOKEN are GitHub Actions secrets, not runtime.
