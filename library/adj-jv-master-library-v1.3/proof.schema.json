{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/adjjvmorii26-png/ixpansion/blob/main/library/adj-jv-master-library-v1.3/proof.schema.json",
  "title": "Library Core Proof Object",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "subject",
    "artifact",
    "verifier",
    "procedure",
    "result"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^P-[0-9]{4,}$"
    },
    "kind": {
      "enum": [
        "ci_run",
        "test_run",
        "file_digest"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "claim"
      ],
      "properties": {
        "entry_id": {
          "type": "string",
          "pattern": "^[A-Z]-[0-9]{2,}$"
        },
        "claim": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "sha256"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^(repo://.+|github-artifact://[0-9]+)$",
          "description": "A repository-relative file or a GitHub Actions artifact ID whose downloaded bytes are SHA-256 checked."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "environment",
        "environment_sha256",
        "reproducible"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "reproducible": {
          "type": "boolean"
        },
        "environment_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "observed_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "run_url",
        "workflow",
        "commit_sha",
        "conclusion"
      ],
      "properties": {
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "run_url": {
          "type": "string",
          "pattern": "^https://github\\.com/.+/actions/runs/[0-9]+$"
        },
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40,64}$"
        },
        "conclusion": {
          "enum": [
            "success",
            "failure",
            "cancelled",
            "skipped",
            "timed_out",
            "action_required",
            "neutral"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ci_run"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "run"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "test_run"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "procedure": {
            "properties": {
              "reproducible": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
